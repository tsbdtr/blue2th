#!/usr/bin/env bash
# Pre-commit quality gate for blue2th.
# Install once with: git config core.hooksPath .githooks
#
# pipefail matters here: without it a `cmd | tail` pipeline reports tail's exit
# status, so a failing gate would let the commit through unnoticed.
set -euo pipefail

echo "--- fmt ---"
cargo fmt --check

# Host, Android and wasm: the script announces each of its three runs itself.
scripts/clippy.sh

echo "--- test ---"
cargo test --workspace

echo "--- ok ---"
